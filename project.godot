; Engine configuration file.
; Godot 4.5 project — World Economy: Build Your Empire

config_version=5

[application]

config/name="World Economy: Build Your Empire"
config/description="Mô phỏng kinh tế toàn cầu — xây dựng đế chế kinh doanh của riêng bạn."
config/version="0.2.0-prototype"
run/main_scene="res://src/ui/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

SimBridge="*res://src/app/sim_bridge.gd"
GameSession="*res://src/app/game_session.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/aspect="expand"

[gui]

common/snap_controls_to_pixels=true

[internationalization]

locale/fallback="vi"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.1, 0.17, 1)
