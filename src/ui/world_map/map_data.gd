## Trả về danh sách polygon dạng PackedVector2Array(lon, lat).
static func polygons() -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = []
	for flat: Array in LANDMASSES:
		var poly := PackedVector2Array()
		for i in range(0, flat.size() - 1, 2):
			poly.append(Vector2(float(flat[i]), float(flat[i + 1])))
		out.append(poly)
	return out
